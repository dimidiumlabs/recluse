set -eu

CARGO_TERM_COLOR=always
export CARGO_TERM_COLOR

if ! command -v mise >/dev/null 2>&1; then
    mise_version=2026.7.5
    case $(uname -m) in
        x86_64)
            mise_platform=linux-x64
            mise_sha256=be92da3afb180dc71b3ce6fcaaaf2f393812c9c50e9a64c9cb6706cf28edb486
            ;;
        aarch64)
            mise_platform=linux-arm64
            mise_sha256=9020f7453931a6873d60cf204d5935ebd08633b25f675b0820cd06862b4b6450
            ;;
        *)
            echo "unsupported architecture for mise: $(uname -m)" >&2
            exit 1
            ;;
    esac

    mise_root="/tmp/mise-$mise_version-$mise_platform"
    mise_archive="$mise_root.tar.gz"

    rm -rf "$mise_root"
    mkdir -p "$mise_root"
    curl --proto '=https' --tlsv1.2 -fsSL \
        "https://github.com/jdx/mise/releases/download/v$mise_version/mise-v$mise_version-$mise_platform.tar.gz" \
        -o "$mise_archive"

    printf '%s  %s\n' "$mise_sha256" "$mise_archive" | sha256sum --check
    tar -xzf "$mise_archive" -C "$mise_root" --strip-components=1 mise/bin/mise
    rm -f "$mise_archive"

    PATH="$mise_root/bin:$PATH"
    export PATH
fi

MISE_IGNORED_CONFIG_PATHS=${MISE_IGNORED_CONFIG_PATHS:-${XDG_CONFIG_HOME:-$HOME/.config}/mise/config.toml}
export MISE_IGNORED_CONFIG_PATHS

if [ "$(git rev-parse --is-shallow-repository)" = true ]; then
    if [ -n "${GITHUB_REF:-}" ]; then
        git fetch --unshallow --tags origin "$GITHUB_REF"
    else
        git fetch --unshallow --tags
    fi
fi

# Legal checks
mise run signoff
mise run licenses

# Lint, tests, and coverage
mise bootstrap --locked --yes --update
mise exec -- cargo fmt --all --check
mise exec -- shellcheck Mirumfile pkg/scripts/*.sh tests/smoke/*.sh
mise exec -- cargo clippy --workspace --all-targets --all-features --release --locked -- -D warnings

mise exec -- cargo test --all-features --release --locked
mkdir -p target/coverage
mise exec -- cargo llvm-cov --all-features --workspace --lcov \
    --output-path target/coverage/lcov.info

base_version=$(mise exec -- cargo metadata --no-deps --format-version 1 |
    mise exec -- jq -r '.packages[] | select(.name == "tesor") | .version')
[ -n "$base_version" ] || {
    echo "cannot determine tesor version" >&2
    exit 1
}
revision=${GITHUB_SHA:-$(git rev-parse HEAD)}
timestamp=$(git log -1 --format=%ct)

case ${GITHUB_REF:-} in
    refs/tags/v*)
        tag_version=${GITHUB_REF#refs/tags/v}
        [ "$tag_version" = "$base_version" ] || {
            echo "tag version $tag_version does not match Cargo.toml version $base_version" >&2
            exit 1
        }
        package_version=$base_version
        artifact_version=$base_version
        ;;
    refs/heads/main)
        package_version="$base_version~nightly.$timestamp"
        artifact_version="$base_version-nightly.$timestamp"
        ;;
    *)
        package_version="$base_version~nightly.$timestamp"
        artifact_version="$base_version-pr.${GITHUB_RUN_NUMBER:-local}"
        ;;
esac

if [ "${GITHUB_EVENT_NAME:-}" = push ]; then
    case ${GITHUB_REF:-} in
        refs/heads/main | refs/tags/v*) ;;
        *)
            echo "ref is not publishable: ${GITHUB_REF:-unset}" >&2
            exit 1
            ;;
    esac
fi

# Packages and architecture-specific container inputs
rm -rf dist .container
for architecture in amd64 arm64; do
    case $architecture in
        amd64) target=x86_64-unknown-linux-musl ;;
        arm64) target=aarch64-unknown-linux-musl ;;
    esac

    mise exec -- cargo zigbuild \
        --package tesor \
        --bin tesor \
        --release \
        --locked \
        --target "$target"

    container_binary=".container/binary-$architecture/tesor"
    install -Dm0755 "target/$target/release/tesor" "$container_binary"
    install -Dm0755 "$container_binary" target/release/tesor
    mise run package -- \
        --version "$package_version" \
        --arch "$architecture" \
        --output dist \
        deb rpm
done

install -Dm0755 .container/binary-amd64/tesor target/release/tesor
./tests/smoke/run-local.sh

# Nightly release and package repositories
if [ "${GITHUB_EVENT_NAME:-}" = push ] && [ "${GITHUB_REF:-}" = refs/heads/main ]; then
    release_tag=nightly
    if mise exec -- gh api \
        "repos/$GITHUB_REPOSITORY/git/ref/tags/$release_tag" >/dev/null 2>&1; then
        mise exec -- gh api --method PATCH \
            "repos/$GITHUB_REPOSITORY/git/refs/tags/$release_tag" \
            -f "sha=$revision" -F force=true >/dev/null
    else
        mise exec -- gh api --method POST \
            "repos/$GITHUB_REPOSITORY/git/refs" \
            -f "ref=refs/tags/$release_tag" -f "sha=$revision" >/dev/null
    fi

    if mise exec -- gh release view "$release_tag" \
        --repo "$GITHUB_REPOSITORY" >/dev/null 2>&1; then
        for asset in $(mise exec -- gh release view "$release_tag" \
            --repo "$GITHUB_REPOSITORY" \
            --json assets --jq '.assets[].name'); do
            mise exec -- gh release delete-asset "$release_tag" "$asset" \
                --repo "$GITHUB_REPOSITORY" --yes
        done
        mise exec -- gh release edit "$release_tag" \
            --repo "$GITHUB_REPOSITORY" \
            --title "$release_tag" \
            --notes "Last successful build from \`main\` branch.

**Release checks**: $GITHUB_SERVER_URL/$GITHUB_REPOSITORY/actions/runs/$GITHUB_RUN_ID"
    else
        mise exec -- gh release create "$release_tag" \
            --repo "$GITHUB_REPOSITORY" \
            --title "$release_tag" \
            --notes "Last successful build from \`main\` branch.

**Release checks**: $GITHUB_SERVER_URL/$GITHUB_REPOSITORY/actions/runs/$GITHUB_RUN_ID"
    fi
    mise exec -- gh release upload "$release_tag" dist/* \
        --repo "$GITHUB_REPOSITORY"

    mise run publish -- \
        --service tesor \
        --channel nightly \
        --input dist \
        deb rpm
fi

# OCI image and chart
repository_owner=$(printf '%s' "${GITHUB_REPOSITORY_OWNER:-dimidiumlabs}" |
    tr '[:upper:]' '[:lower:]')
repository=${GITHUB_REPOSITORY:-dimidiumlabs/tesor}
server_url=${GITHUB_SERVER_URL:-https://github.com}
image="ghcr.io/$repository_owner/tesor"

builder=$(docker buildx create --driver docker-container --use)
cleanup_builder() {
    docker buildx rm "$builder" >/dev/null 2>&1 || true
}
trap cleanup_builder 0
docker buildx inspect --bootstrap

build_image() {
    mise run container -- \
        --context . \
        --file Dockerfile \
        --platform linux/amd64,linux/arm64 \
        --cache-scope tesor \
        --tag "$image:sha-$revision" \
        --tag "$image:$artifact_version" \
        --label "org.opencontainers.image.revision=$revision" \
        --label "org.opencontainers.image.source=$server_url/$repository" \
        --label "org.opencontainers.image.version=$artifact_version" \
        "$@"
}

publish_chart() {
    mise run chart -- \
        --chart charts/tesor \
        --version "$artifact_version" \
        --app-version "$artifact_version" \
        "$@"
}

if [ "${GITHUB_EVENT_NAME:-}" = push ]; then
    mise exec -- gh auth token |
        docker login ghcr.io --username "$GITHUB_ACTOR" --password-stdin
    mise exec -- gh auth token | mise exec -- helm registry login ghcr.io \
        --username "$GITHUB_ACTOR" --password-stdin

    case ${GITHUB_REF:-} in
        refs/heads/main) build_image --tag "$image:nightly" --push ;;
        refs/tags/v*) build_image --tag "$image:latest" --push ;;
        *) build_image --push ;;
    esac
    publish_chart --push "oci://ghcr.io/$repository_owner/charts"
else
    build_image
    publish_chart
fi
